# Push-up Analysis API - Environment Variables
# Copy to .env and fill in your values

# Model Configuration
CHECKPOINT_PATH=checkpoints/lstm_pushup.pt
MODEL_VERSION=1.0.0
TARGET_FPS=15
MAX_SECONDS=30.0
FEATURE_DIM=19
LSTM_HIDDEN_SIZE=64
LSTM_NUM_LAYERS=2
LSTM_DROPOUT=0.2

# Rep Counting Thresholds
MIN_CONCENTRIC_FRAMES=3
MIN_ECCENTRIC_FRAMES=3
MIN_IDLE_FRAMES=5

# API Configuration
MAX_UPLOAD_MB=50
HOST=0.0.0.0
PORT=8000

# LLM Configuration (OpenAI)
# REQUIRED: Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_CHAT_MODEL is the preferred variable name (also accepts OPENAI_MODEL)
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_S=10.0
OPENAI_MAX_TOKENS=300
OPENAI_TEMPERATURE=0.3

# Logging
LOG_LEVEL=INFO